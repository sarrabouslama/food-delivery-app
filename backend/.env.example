# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ── Database (Postgres) ───────────────────────────────────────
# Used by Prisma
DATABASE_URL="postgresql://postgres:Four2004%40@localhost:5432/food_delivery_app"

# ── Redis ────────────────────────────────────────────────────
# Used by Socket.io Redis adapter (when scaling to multiple instances)
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT (Member 1 fills these) ────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change_me_refresh_in_production
JWT_REFRESH_EXPIRES_IN=7d


STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here