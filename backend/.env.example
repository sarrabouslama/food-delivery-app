# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# ── Database (Postgres) ───────────────────────────────────────
# Used by Prisma
DATABASE_URL=postgresql://username:password@localhost:5432/food_delivery_app

# ── Redis ────────────────────────────────────────────────────
# Used by Socket.io Redis adapter (when scaling to multiple instances)
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT (Member 1 fills these) ────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change_me_refresh_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ── Stripe (Member 3 fills these) ─────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...